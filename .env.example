# Goodwill Gold configuration
#
# In the Claude Code web/cloud environment, Claude API access is provided
# automatically via ANTHROPIC_BASE_URL + managed credentials, so you do NOT
# need to set ANTHROPIC_API_KEY to run locally in that environment.
#
# To run anywhere else, create a key at https://console.anthropic.com and set:
# ANTHROPIC_API_KEY=sk-ant-...

# Model used for identification + pricing (vision + web_search + structured outputs).
CLAUDE_MODEL=claude-opus-4-8

# Port the FastAPI server listens on.
PORT=8000
